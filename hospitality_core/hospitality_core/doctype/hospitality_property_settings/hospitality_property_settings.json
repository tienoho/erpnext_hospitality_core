  {
   "fieldname": "section_break_printing",
   "fieldtype": "Section Break",
   "label": "Automatic Printing"
  },
  {
   "fieldname": "enable_auto_print",
   "fieldtype": "Check",
   "label": "Enable Automatic Receipt Printing",
   "default": 0,
   "description": "Automatically print receipts to the system's default printer when a POS Invoice is submitted"
  },
  {
   "fieldname": "receipt_print_format",
   "fieldtype": "Link",
   "label": "Receipt Print Format",
   "options": "Print Format",
   "description": "Custom print format for receipts (leave blank to use default POS Invoice format)",
   "depends_on": "enable_auto_print"
  },
  {
   "fieldname": "print_copies",
   "fieldtype": "Int",
   "label": "Number of Copies to Print",
   "default": 3,
   "description": "Number of receipt copies to print automatically",
   "depends_on": "enable_auto_print"
  },
  {
   "description": "If the 'vietnam_einvoice' app is installed, it is the real issuance path and reads its OWN settings from 'Vietnam E-Invoice Config' (per Company) instead — the fields below are only used as a local fallback when that app is not installed.",
   "fieldname": "section_break_einvoice",
   "fieldtype": "Section Break",
   "label": "E-Invoice (TT78 / NĐ123) — Fallback Provider"
  },
  {
   "default": "Mock",
   "description": "Mock generates a fake lookup code locally for testing the Guest Folio button/UI without a real tax-authority connection. Switch to a real provider once the API Endpoint/Key/Tax Code below are configured.",
   "fieldname": "einvoice_provider",
   "fieldtype": "Select",
   "label": "E-Invoice Provider",
   "options": "Mock\nVNPT\nViettel\nMISA meInvoice"
  },
  {
   "default": "8",
   "fieldname": "einvoice_default_vat_rate",
   "fieldtype": "Percent",
   "label": "Default VAT Rate (%)"
  },
  {
   "fieldname": "column_break_einvoice",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.einvoice_provider!='Mock'",
   "fieldname": "einvoice_api_endpoint",
   "fieldtype": "Data",
   "label": "API Endpoint"
  },
  {
   "depends_on": "eval:doc.einvoice_provider!='Mock'",
   "fieldname": "einvoice_api_key",
   "fieldtype": "Password",
   "label": "API Key / Token"
  },
  {
   "depends_on": "eval:doc.einvoice_provider!='Mock'",
   "fieldname": "einvoice_tax_code",
   "fieldtype": "Data",
   "label": "Company Tax Code (MST)"
  },
  {
   "default": "1",
   "fieldname": "enable_pos_cash_register",
   "fieldtype": "Check",
   "label": "Enable POS Cash Register E-Invoice (Mã CQT)"
  },
  {
   "default": "1C26MNG",
   "depends_on": "enable_pos_cash_register",
   "fieldname": "pos_invoice_template",
   "fieldtype": "Data",
   "label": "POS Cash Register Invoice Template (Ký hiệu mẫu)"
  },
  {
   "fieldname": "section_break_vietqr",
   "fieldtype": "Section Break",
   "label": "Cấu hình Thanh toán VietQR (NAPAS 247)"
  },
  {
   "default": "1",
   "fieldname": "enable_vietqr",
   "fieldtype": "Check",
   "label": "Bật Thanh toán VietQR Động"
  },
  {
   "default": "970415",
   "depends_on": "enable_vietqr",
   "description": "VietinBank (970415), MBBank (970422), Vietcombank (970436), BIDV (970418), Techcombank (970407)...",
   "fieldname": "vietqr_bank_id",
   "fieldtype": "Select",
   "label": "Mã Ngân hàng Thụ hưởng (BIN)",
   "options": "970415\n970422\n970436\n970418\n970407\n970405\n970423\n970416\n970432\n970441"
  },
  {
   "depends_on": "enable_vietqr",
   "fieldname": "vietqr_account_number",
   "fieldtype": "Data",
   "label": "Số Tài khoản Thụ hưởng"
  },
  {
   "depends_on": "enable_vietqr",
   "fieldname": "vietqr_account_name",
   "fieldtype": "Data",
   "label": "Tên Chủ Tài khoản (In hoa không dấu)"
  },
  {
   "fieldname": "column_break_vietqr",
   "fieldtype": "Column Break"
  },
  {
   "default": "compact2",
   "depends_on": "enable_vietqr",
   "fieldname": "vietqr_template",
   "fieldtype": "Select",
   "label": "Giao diện Mẫu VietQR",
   "options": "compact2\nqr_only\nprint\ncompact"
  },
  {
   "default": "TCG",
   "depends_on": "enable_vietqr",
   "description": "Tiền tố nội dung chuyển khoản, ví dụ: TCG 101 FOL-00123",
   "fieldname": "vietqr_content_prefix",
   "fieldtype": "Data",
   "label": "Tiền tố Nội dung Chuyển khoản"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 1
  },
  {
   "role": "Hospitality User",
   "read": 1,
   "write": 0,
   "create": 0,
   "report": 1
  }
 ]
